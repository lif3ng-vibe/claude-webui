{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "claude-webui",
  "version": "0.1.0",
  "identifier": "app.claude-webui",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd web && npm run dev",
    "beforeBuildCommand": "npm run build:web && npm run build:server"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "single-instance": { "deepLink": false }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist-server",
      "../web/dist"
    ]
  }
}