{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面壳所有窗口权限：core 默认 + event（日志 listen）。windows 用 * 覆盖运行时动态创建的窗口（terminal/projects/conversations 等）；remote 覆盖 sidecar 的 http://localhost:<随机端口>（生产环境前端由本地 sidecar 提供、非 frontendDist，需显式授权 IPC）",
  "windows": ["*"],
  "remote": { "urls": ["http://localhost:*/*", "http://127.0.0.1:*/*"] },
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-desktop-open-window",
    "allow-desktop-minimize",
    "allow-desktop-toggle-maximize",
    "allow-desktop-close",
    "allow-desktop-set-always-on-top",
    "allow-desktop-is-always-on-top",
    "allow-desktop-open-devtools",
    "allow-service-status",
    "allow-service-start",
    "allow-service-stop",
    "allow-service-restart",
    "allow-service-get-logs"
  ]
}